# NexusAI Enterprise Multi-Agent RAG Platform Configuration

# Environment & Server
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="NexusAI Enterprise Multi-Agent RAG Platform"

# Security (Change in production)
JWT_SECRET=nexusai_enterprise_secure_token_key_change_in_production_2026_xyz
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database with pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nexusai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexusai

# Google Gemini API (Google GenAI Python SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Ingestion & Chunking
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150
MAX_FILE_SIZE_MB=50

# Retrieval & Multi-Agent Parameters
DEFAULT_TOP_K=5
HYBRID_ALPHA=0.5
MAX_AGENT_RETRIES=2
MAX_WORKFLOW_CYCLES=4

# Model Pricing Tiers (USD per 1 Million Tokens)
COST_PER_1M_INPUT_TOKENS=0.15
COST_PER_1M_OUTPUT_TOKENS=0.60
COST_PER_1M_EMBEDDING_TOKENS=0.025

# Optional Google Cloud Storage Integration
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
GCS_BUCKET_NAME=
