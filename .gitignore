# ==============================================================================
# NexusAI — Enterprise Multi-Agent RAG Platform .gitignore
# ==============================================================================

# --- Environment & Secrets (Mandatory Security) ---
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.pem
*.key
*.cert

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Node.js & Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.vite/
frontend/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Databases & Persistent Storage ---
*.db
*.sqlite
*.sqlite3
nexusai.db
backend/nexusai.db
pgdata/

# Uploaded User Documents
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# --- Terraform & Cloud Infrastructure ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Docker ---
docker-compose.override.yml

# --- IDEs & OS Specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
